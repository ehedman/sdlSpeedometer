        NEW_DEPTH_WARNING=$(awk -v v1="$NEW_DEPTH_WARNING" -v v2="$multiplier" 'BEGIN {printf "%.1f\n", v1 * v2}')
    fi
    echo "UPDATE warnings SET depthw = '$NEW_DEPTH_WARNING' WHERE Id=1;" >> "$SQLFILE"
  fi
}

