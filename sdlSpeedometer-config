do_set_depth_warning() {
    whiptail --msgbox "\
Enter the audible depth warning message level in $CURRENT_UNITS_DEPTH
" 20 70 1

  CURRENT_DEPTH_WARNING=$(sqlite3 $SPEEDOMETER_DB 'SELECT depthw FROM warnings;')
  if [ $CURRENT_UNITS -eq 1 ]; then
    multiplier=3.2808399
    CURRENT_DEPTH_WARNING=$(awk -v v1="$CURRENT_DEPTH_WARNING" -v v2="$multiplier" 'BEGIN {printf "%.1f\n", v1 * v2}')
  fi

  NEW_DEPTH_WARNING=$(whiptail --inputbox "Please enter the depth warning in $CURRENT_UNITS_DEPTH" 20 60 -- "$CURRENT_DEPTH_WARNING" 3>&1 1>&2 2>&3)
  if [ -n "$NEW_DEPTH_WARNING" ]; then
