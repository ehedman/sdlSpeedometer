do_set_record_limit() {
    whiptail --msgbox "\
Enter the number to limit the recorded NMEA file size.
" 20 70 1

  CURRENT_RWFILEZ_LIMIT=$(sqlite3 $SPEEDOMETER_DB 'SELECT rwfilez FROM config;')
  current=$(awk "BEGIN {print $CURRENT_RWFILEZ_LIMIT / 1000}")
  NEW_RWFILEZ_LIMIT=$(whiptail --inputbox "Please enter a decimal number in KB between 10 and 2000" 20 60 "$current" 3>&1 1>&2 2>&3)
  if [ -n "$NEW_RWFILEZ_LIMIT" ]; then

    if [[ -n "$NEW_RWFILEZ_LIMIT" && "$NEW_RWFILEZ_LIMIT" =~ ^[0-9]+$ ]]; then
        if (( NEW_RWFILEZ_LIMIT >= 10 && NEW_RWFILEZ_LIMIT <= 2000 )); then
            NEW_RWFILEZ_LIMIT=$((NEW_RWFILEZ_LIMIT * 1000))
        else
            NEW_RWFILEZ_LIMIT=10000
        fi
    else
        NEW_RWFILEZ_LIMIT=10000
    fi
    echo "UPDATE config SET rwfilez = '$NEW_RWFILEZ_LIMIT' WHERE Id=1;" >> "$SQLFILE"
    RWFILEZ_LIMIT=$NEW_RWFILEZ_LIMIT
  fi
}

