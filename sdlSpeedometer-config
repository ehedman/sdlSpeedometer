is_pulseaudio() {
  pgrep pulseaudio > /dev/null || pgrep pipewire-pulse > /dev/null
  return $?
}

do_set_audio_device() {

    CURRENT_AUDIO_DEVICE=$(sqlite3 $SPEEDOMETER_DB 'SELECT audiodev FROM config;' | awk -F'[:,]' '{print $2}')

    if is_pulseaudio ; then
    oIFS="$IFS"
 
    list=$(pactl list sinks | grep -e "Sink #" -e "alsa.card_name" | sed s/*//g | sed s/^[' '\\t]*//g | sed s/'Sink #'//g | sed s/'alsa.card_name = '//g | sed s/'bcm2835 '//g | sed s/\"//g | tr '\n' '/')
    if [ -n "$list" ] ; then
        IFS="/"
        AUDIO_OUT=$(whiptail --menu "Choose the audio output. Current is $CURRENT_AUDIO_DEVICE" 20 60 10 ${list} 3>&1 1>&2 2>&3)

    else
        whiptail --msgbox "No internal audio devices found" 20 60 1
        return 1
    fi  
    if [ $? -eq 0 ]; then
      sudo -u $USER XDG_RUNTIME_DIR=/run/user/$SUDO_UID pactl set-default-sink $AUDIO_OUT
    fi
    IFS="$oIFS"
    else
        if aplay -l | grep -q "bcm2835 ALSA"; then
            AUDIO_OUT=$(whiptail --menu "Choose the audio output. Current is $CURRENT_AUDIO_DEVICE" 20 60 10 \
              "0" "Auto" \
              "1" "Force 3.5mm ('headphone') jack" \
              "2" "Force HDMI" \
            3>&1 1>&2 2>&3)

            AUDIO_OUT=$1

            if [ "$?" -eq 0 ] && [ -n "$AUDIO_OUT" ]; then
                amixer cset numid=3 "$AUDIO_OUT"
            fi
        else
            n=0
            array=""
            while [ $n -le 9 ]
            do
              CARD=$(LC_ALL=C aplay -l | grep "card $n" | cut -d [ -f 2 | cut -d ] -f 1)
              if [ -z "$CARD" ] ; then
                n=$(( n+1 ))
                continue
              else
                if [ -z "$array" ] ; then
                  array=$n"/"$CARD
                else
                  #shellcheck disable=2027
                  array=$array"/"$n"/"$CARD
                fi
              fi
              n=$(( n+1 ))
            done

            if [ $n -eq 0 ] ; then
              whiptail --msgbox "No audio devices found" 20 60 1
              false
            else
              oIFS="$IFS"
              IFS="/"
              AUDIO_OUT=$(whiptail --menu "Choose the audio output. Current is $CURRENT_AUDIO_DEVICE" 20 60 10 ${array} 3>&1 1>&2 2>&3)
              IFS="$oIFS"
            fi
            if [ "$?" -eq 0 ] && [ -n "$AUDIO_OUT" ]; then
                NEW_AUDIO_DEVICE="hw:${AUDIO_OUT},0"
                echo "UPDATE config SET audiodev = '$NEW_AUDIO_DEVICE' WHERE Id=1;" >> "$SQLFILE"
            fi
        fi
    fi
}

list_wlan_interfaces() {
  for dir in /sys/class/net/*/wireless; do
    if [ -d "$dir" ]; then
      basename "$(dirname "$dir")"
    fi
  done
}

do_raspi_config() {

if [ "$(id -u)" -ne 0 ]; then
    whiptail --msgbox "\
Ony root can do this. Enable yourself to become a sudouser to run this. See man sudoers.
" 20 70 1
    return
fi

    whiptail --yesno --defaultno "\
The raspi-config tool helps you to configure your Raspberry Pi; several \
settings can be changed with this tool without having to know the correct commands to use.\\n 
Enter YES to run raspi-config.
" 20 70 1

  if [ $? -eq 0 ]; then # yes
    /usr/bin/raspi-config
    return 0
  fi
}

do_config_menu() {
  FUN=$(whiptail --title "sdlSpeedometer Configuration Tool (sdlSpeedometer-config)" --menu "Config Options" $WT_HEIGHT $WT_WIDTH $WT_MENU_HEIGHT --cancel-button Finish --ok-button Select \
    "1 Serial device" "Enter device name for the NMEA-0183 port" \
    "2 Serial speed" "Enter baud rate for the NMEA-0183 port" \
    "3 NMEA Network" "Enter NMEA-0183 server name" \
    "4 NMEA Net port" "Enter NMEA-0183 server port" \
    "5 VNC Server port" "Enter VNC server port" \
    "6 GUI style" "Enter GUI Style" \
    "7 Units" "Enter Units Style" \
    "8 Limits" "Enter record file size limit" \
    "9 Application  1" "Enter External Application for page COG" \
    "10 Application 2" "Enter External Application for page SOG" \
    "11 Application 3" "Enter External Application for page DPT" \
    "12 Application 4" "Enter External Application for page WND" \
    "13 Application 5" "Enter External Application for page GPS" \
    "14 Application 6" "Enter External Application for page PWR" \
    "15 Compass offset" "Enter manual compass offset" \
    "16 Compass heel offset" "Enter manual compass heel offset" \
    "17 Compass pitch offset" "Enter manual compass pitch offset" \
    "18 Depth warning" "Enter the audible depth level warning" \
    "19 Wessel draft" "Enter the wessel draft level warning" \
    "20 Voltage warning" "Enter the audible low voltage level warning" \
    "21 Current warning" "Enter the audible high current level warning" \
    "22 Audio Device" "Enter the audio device used for spoken warnings" \
    "23 RTSP Camera" "Enter the URL for an RTSP Camera" \
    "24 Configuration" "Run raspi-config" \
    3>&1 1>&2 2>&3)
  RET=$?
  if [ $RET -eq 1 ]; then
    return 1
  elif [ $RET -eq 0 ]; then 
    case "$FUN" in
      1\ *) do_set_serial_device ;;
      2\ *) do_set_serial_speed ;;
      3\ *) do_set_nmea_server ;;
      4\ *) do_set_nmea_port ;;
      5\ *) do_set_vnc_port ;;
      6\ *) do_set_gui_style ;;
      7\ *) do_set_units_style ;;
      8\ *) do_set_record_limit ;;
      9\ *) do_set_external_app 1 ;;
      10\ *) do_set_external_app 2 ;;
      11\ *) do_set_external_app 3 ;;
      12\ *) do_set_external_app 4 ;;
      13\ *) do_set_external_app 5 ;;
      14\ *) do_set_external_app 6 ;;
      15\ *) do_set_compass_offset ;;
      16\ *) do_set_compass_heel_offset ;;
      17\ *) do_set_compass_pitch_offset ;;
      18\ *) do_set_depth_warning ;;
      19\ *) do_set_wessel_draft ;;
      20\ *) do_set_voltage_warning ;;
      21\ *) do_set_current_warning ;;
      22\ *) do_set_audio_device ;;
      23\ *) do_set_camera_url ;;
      24\ *) do_raspi_config ;;
      *) whiptail --msgbox "Programmer error: unrecognized option" 20 60 1 ;;
    esac || whiptail --msgbox "There was an error running option $FUN" 20 60 1
  fi
}

calc_wt_size

while true; do
  do_config_menu
  RET=$?
  if [ $RET -eq 1 ]; then
    do_finish
  fi
done
